# Copia este archivo como ".env" y ajusta los valores para tu entorno local.
# El archivo ".env" no se versiona.

# Contraseña del usuario "sa" del contenedor de SQL Server. Debe cumplir la
# política de SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas,
# dígitos y símbolos.
MSSQL_SA_PASSWORD=Cambia_esta_clave_123

# Puerto del host por el que se expone SQL Server. Se usa uno distinto del
# 1433 para no chocar con una instancia local ya instalada.
MSSQL_PORT=14333
